rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function validProfileNameUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        !changed.hasAny(['name', 'displayName'])
        || (
          request.resource.data.keys().hasAll(['name', 'displayName'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.name == request.resource.data.displayName
        )
      )
      && (
        !request.resource.data.keys().hasAny(['name'])
        || (request.resource.data.name is string && request.resource.data.name.size() <= 100)
      )
      && (
        !request.resource.data.keys().hasAny(['displayName'])
        || (
          request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
        )
      );
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'displayName', 'photoURL', 'updatedAt'])
        && validProfileNameUpdate()
        && (
          !request.resource.data.keys().hasAny(['photoURL'])
          || (
            request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048
          )
        )
        && request.resource.data.updatedAt == request.time;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
